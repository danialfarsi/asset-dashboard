        ],

        # ────────────── استراتژیک ──────────────
        'شیوه‌نامه تصمیم‌گیری استراتژیک': [
            'تصمیم‌گیری', 'استراتژیک', 'شیوه‌نامه', 'Decision Making', 'Strategic Decision',
        ],
        'بهترین شیوه‌های غیررسمی (Best Practices)': [
